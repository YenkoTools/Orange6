{
  "version": "2.0.0",
  "tasks": [
    // ── API ──────────────────────────────────────────────────────────
    {
      "label": "api: restore",
      "type": "shell",
      "command": "dotnet restore ${workspaceFolder}/Api/Api.csproj",
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "api: build",
      "type": "shell",
      "command": "dotnet build ${workspaceFolder}/Api/Api.csproj /property:GenerateFullPaths=true /consoleloggerparameters:NoSummary",
      "dependsOn": "api: restore",
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      // Starts the Azure Functions host in the background.
      // A problemMatcher pattern detects "Host lock lease acquired" which signals
      // the host is fully initialised and ready to accept requests.
      "label": "api: func host start",
      "type": "shell",
      "command": "func host start --port 7071",
      "options": { "cwd": "${workspaceFolder}/Api" },
      "dependsOn": "api: build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "func",
        "pattern": [{ "regexp": "\\b\\B", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Azure Functions Core Tools.*",
          "endsPattern": ".*Host lock lease acquired by instance ID.*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "api" }
    },

    // ── Client ───────────────────────────────────────────────────────
    {
      "label": "client: npm install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/Client" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      // Starts the Astro dev server.  Waits for the API to be ready first via
      // dependsOn so the full-stack compound launch has a deterministic startup order.
      "label": "client: astro dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/Client" },
      "dependsOn": ["api: func host start", "client: npm install"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "astro",
        "pattern": [{ "regexp": "\\b\\B", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*astro.*",
          "endsPattern": ".*Local.*http://localhost:4321.*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "client" }
    }
  ]
}
