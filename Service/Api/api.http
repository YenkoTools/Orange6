@baseUrl = http://localhost:7071/api

### Get API Version
GET {{baseUrl}}/version
Accept: application/json

### Get Paged Users
GET {{baseUrl}}/users?pageNumber=1&pageSize=10
Accept: application/json

### Create User
POST {{baseUrl}}/users
Content-Type: application/json

{
    "username": "jdoe",
    "email": "jdoe@example.com",
    "firstName": "John",
    "lastName": "Doe"
}

### Get User By Id
GET {{baseUrl}}/users/1
Accept: application/json

### Update User By Id
PUT {{baseUrl}}/users/8
Content-Type: application/json

{
    "username": "ginnypotter",
    "email": "ginny.potter@hogwarts.edu",
    "firstName": "Ginny",
    "lastName": "Potter",
    "updatedAt": "2026-03-05T00:00:00Z"
}

### Delete User By Id
DELETE {{baseUrl}}/users/7


### Create Draco User
POST {{baseUrl}}/users
Content-Type: application/json

{
    "username": "dracomalfoy",
    "email": "draco.malfoy@hogwarts.edu",
    "firstName": "Draco",
    "lastName": "Malfoy"
}
